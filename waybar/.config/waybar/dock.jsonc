{
  "layer": "top",
  "position": "bottom",
  "height": 52,
  "margin-bottom": 10,
  "margin-top": 0,
  "exclusive": false,
  "passthrough": false,
  "spacing": 0,
  "modules-center": ["wlr/taskbar"],
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 36,
    "spacing": 0,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [
       "Waybar"
    ],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition"
    }
  }
}

{
  "layer": "top",
  "position": "bottom",
  "height": 64,
  "margin-bottom": 10,
  "exclusive": false,
  "passthrough": false,
  "fixed-center": true,
  "modules-center": [
    "custom/terminal",
    "custom/browser",
    "custom/obsidian",
    "custom/separator",
    "wlr/taskbar"
  ],
  "custom/terminal": {
    "format": "󰆍",
    "on-click": "uwsm-app -- ghostty",
    "tooltip-format": "Terminal"
  },
  "custom/browser": {
    "format": "󰈹",
    "on-click": "uwsm-app -- brave",
    "tooltip-format": "Brave Browser"
  },
  "custom/obsidian": {
    "format": "󱓧",
    "on-click": "uwsm-app -- obsidian",
    "tooltip-format": "Obsidian"
  },
  "custom/separator": {
    "format": " ",
    "tooltip": false
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 36,
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["Waybar"]
  }
}

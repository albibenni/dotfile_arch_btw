# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

## TITLE
title = "Hello Benni"
keybind = shift+enter=text:\x1b\r
keybind = ctrl+shift+q=close_surface

# Font
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
# Managed by Omarchy's global Text Size control. It rewrites this line when
# changed, so keep the setting in the main Ghostty config.
font-size = 12
# Do not inherit a manually shrunk font size from an existing Ghostty window.
window-inherit-font-size = false
font-feature = -liga
font-thicken = true
font-family = CaskaydiaCove Nerd Font
#font-family = JetBrainsMono Nerd Font
#font-family = FiraCode Nerd Font
#font-family = BlexMono Nerd Font Propo

#background-opacity = 1

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env
shell-integration = bash


# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
